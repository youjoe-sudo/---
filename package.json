  "version": "1.0.0",
  "description": "نظام متابعة الغياب اليومي - مديري التربية والتعليم بالشرقية (تطبيق محلي)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
